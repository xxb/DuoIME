-  if (!dest)
+  if (!dest || !IsOpen())
+    return false;
+  const size_t dest_offset = OffsetOf(dest);
+  if (dest_offset == kInvalidOffset || sizeof(String) > size_ - dest_offset) {
+    LOG(ERROR) << "CopyString destination is outside mapped file.";
     return false;
+  }
   size_t size = src.length() + 1;
   char* ptr = Allocate<char>(size);
   if (!ptr)
     return false;
   std::strncpy(ptr, src.c_str(), size);
+  dest = Find<String>(dest_offset);
+  if (!dest)
+    return false;
   dest->data = ptr;
   return true;
 }

+bool StringTableBuilder::CopyIdsToOffsets(
+    char* base,
+    size_t base_size,
+    const vector<size_t>& offsets) const {
+  if (!base || keys_.size() != offsets.size()) {
+    LOG(ERROR) << "invalid arguments for CopyIdsToOffsets: keys="
+               << keys_.size() << ", offsets=" << offsets.size();
+    return false;
+  }
+  for (size_t i = 0; i < keys_.size(); ++i) {
+    if (offsets[i] > base_size || sizeof(StringId) > base_size - offsets[i]) {
+      LOG(ERROR) << "string reference offset out of range: " << offsets[i];
+      return false;
+    }
+    const StringId id = static_cast<StringId>(keys_[i].id());
+    std::memcpy(base + offsets[i], &id, sizeof(StringId));
+  }
+  return true;
+}
